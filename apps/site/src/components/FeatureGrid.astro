---
import { Wand2, Zap, TestTube2, Target, Gauge, Layers, Disc3, Bug } from 'lucide-react';

const features = [
  { icon: Wand2, title: 'Fluent builder', body: 'Sections with unequal arcs, pointers, skins, rings and speed profiles in one chain. Validated on build().' },
  { icon: Target, title: 'Planned stops', body: 'The deceleration starts at the cruise speed and lands exactly where the server said: centre, random, or an exact angle. Then settle or bounce.' },
  { icon: Zap, title: 'Anticipation', body: 'Creep over the line, stutter on it, or stall just short of the jackpot. The wheel stops once, on the result. Bait the player with one section, land on another.' },
  { icon: Layers, title: 'Dynamic sectors', body: 'Arc shares that move step by step while labels re-centre. Cosmetic states, no math coupling.' },
  { icon: Disc3, title: 'Rings and idle', body: 'An outer ring that triggers an inner one read by an inward pointer. A wheel idling under the reels until the feature fires.' },
  { icon: Gauge, title: 'Typed events', body: 'spin:cruise, pointer:tick, anticipation:bait, spin:landing. Every sound and Spine reaction has a hook.' },
  { icon: TestTube2, title: 'Headless testing', body: 'createTestWheel + FakeTicker run whole spins in Node. No renderer, no timers, no flakes.' },
  { icon: Bug, title: 'Debug view', body: 'A plain graphics skin, an overlay with angles and the planned legs, an ASCII arc, and a window handle for agents.' },
];
---
<section class="border-b border-border/60 py-20">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center mb-12">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        The parts of a bonus wheel you would have to build anyway.
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f) => (
        <div class="group relative overflow-hidden rounded-xl border border-border bg-card p-6 transition-all hover:border-primary/40 hover:-translate-y-0.5">
          <div class="absolute inset-0 bg-foreground opacity-0 transition-opacity group-hover:opacity-[0.03]" aria-hidden></div>
          <div class="relative">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-secondary/80 text-primary ring-1 ring-border">
              <f.icon size={18} strokeWidth={1.7} />
            </div>
            <h3 class="text-base font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">{f.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
