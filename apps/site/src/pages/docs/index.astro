---
import Docs from '../../layouts/Docs.astro';
import { WIKI_NAV } from '../../content/nav.ts';
---
<Docs title="Docs" section="docs" eyebrow="Reference" description="API guides, the generated reference and the glossary for pixi-wheels.">
  <p>
    Hand-written API guides first, then the generated TypeDoc reference for every exported symbol.
  </p>
  <div class="mt-8 space-y-8">
    {WIKI_NAV.map((section) => (
      <section>
        <h2 class="mb-3">{section.title}</h2>
        <div class="grid gap-2 not-prose">
          {section.items.map((item) => (
            <a href={item.href} class="group flex items-center justify-between rounded-lg border border-border bg-card px-4 py-3 text-sm transition-colors hover:border-primary/40 hover:bg-secondary/30">
              <span class="font-medium">{item.label}</span>
              <span class="text-muted-foreground transition-transform group-hover:translate-x-0.5">-&gt;</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Docs>
