---
import Base from './Base.astro';
import { ChevronLeft } from 'lucide-react';
import { articleLd, breadcrumbLd, SITE } from '../lib/seo.ts';

interface Props {
  title?: string;
  description?: string;
  tags?: string[];
  frontmatter?: {
    title?: string;
    description?: string;
    tags?: string[];
    };
}
const props = Astro.props as Props;
const fm = props.frontmatter ?? {};
const title = props.title ?? fm.title ?? 'Recipe';
const description = props.description ?? fm.description ?? `${title}. Live wheel recipes built with pixi-wheels.`;
const tags = props.tags ?? fm.tags ?? [];
const pathname = Astro.url.pathname;

const jsonLd = [
  articleLd({ title, description, path: pathname }),
  // No HowTo here: a recipe page is an umbrella of independent demos, not an
  // ordered procedure. It used to emit one anyway, built from a `steps` field
  // that was `[]` on all twelve pages - i.e. a schema.org HowTo with zero
  // steps on every recipe URL.
  breadcrumbLd([
    { name: SITE.name, url: '/' },
    { name: 'Recipes', url: '/recipes/' },
    { name: title, url: pathname },
  ]),
];
---
<Base
  title={`${title} · ${SITE.name} recipe`}
  description={description}
  path={pathname}
  type="article"
  article={{ section: 'Recipes', tags }}
  jsonLd={jsonLd}
>
  <div class="container max-w-[880px] py-10 animate-fade-in">
    <header class="mb-6">
      <a href="/recipes/" class="mb-4 inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors">
        <ChevronLeft size={14} strokeWidth={2} />
        All recipes
      </a>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      {description && <p class="mt-2 text-muted-foreground max-w-[620px]">{description}</p>}
    </header>


    <article class="prose-docs">
      <slot />
    </article>
  </div>
</Base>
