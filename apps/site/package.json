{
  "name": "@pixi-wheels/site",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node -e \"const fs=require('fs');fs.mkdirSync('src/generated',{recursive:true});fs.copyFileSync('../../packages/pixi-wheels/CHANGELOG.md','src/generated/CHANGELOG.md');\"",
    "llms:gen": "node scripts/build-llms.mjs",
    "api:gen": "typedoc && node scripts/postprocess-api.mjs",
    "predev": "pnpm sync-assets && pnpm api:gen && pnpm llms:gen",
    "prebuild": "pnpm sync-assets && pnpm api:gen && pnpm llms:gen",
    "prepreview": "pnpm sync-assets && pnpm api:gen && pnpm llms:gen",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^6.0.5",
    "@esotericsoftware/spine-pixi-v8": "~4.2.110",
    "@monaco-editor/react": "^4.7.0",
    "@schmooky/zvuk": "^1.14.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.70.0",
    "mermaid": "^11.17.2",
    "pixi-wheels": "workspace:*",
    "pixi.js": "^8.20.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.6.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3"
  }
}
