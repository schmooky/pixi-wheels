{
  "name": "pixi-wheels-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "pixi-wheels monorepo - open-source bonus wheel engine for PixiJS v8.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter pixi-wheels build",
    "build:all": "node scripts/build-all-publishable.mjs",
    "test": "pnpm check:lint && pnpm --filter pixi-wheels test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "pnpm --filter pixi-wheels typecheck",
    "lint": "pnpm --filter pixi-wheels lint",
    "check:no-fancy-unicode": "node scripts/check-no-fancy-unicode.mjs",
    "check:imports": "biome lint packages/pixi-wheels/src",
    "check:lint": "pnpm check:no-fancy-unicode && pnpm check:imports && pnpm check:recipe-globals && pnpm check:recipe-syntax && pnpm check:api-surface",
    "check:recipe-globals": "node scripts/check-recipe-globals.mjs",
    "check:recipe-syntax": "node scripts/check-recipe-syntax.mjs",
    "check:api-surface": "node scripts/check-api-surface.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:publish-contents": "node scripts/check-publish-contents.mjs",
    "commitlint": "commitlint --edit",
    "site:dev": "pnpm --filter @pixi-wheels/site dev",
    "site:build": "pnpm --filter @pixi-wheels/site build",
    "site:preview": "pnpm --filter @pixi-wheels/site preview",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:all && changeset publish",
    "snapshot": "node scripts/snapshot-release.mjs",
    "size": "node scripts/size-check.mjs",
    "size:check": "node scripts/size-check.mjs --check",
    "size:update": "node scripts/size-check.mjs --update",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,md,mdx,astro,yml,yaml,json}": [
      "node scripts/check-no-fancy-unicode.mjs"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
